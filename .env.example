# Copiar a .env y completar con valores reales (.env NO se versiona).
# Clave del usuario root de MySQL (contenedor mysql y servicios que se conectan a el)
DB_PASSWORD=cambiar-clave-mysql
# Clave del keystore core-signing-key.p12 montado desde ./keys
JWT_KEYSTORE_PASSWORD=cambiar-clave-keystore
# Secretos OAuth2 client_credentials: DISTINTOS entre si, aleatorios y largos (ej: openssl rand -base64 32)
BBF_WEB_SECRET=cambiar-secreto-web
BBF_MOBILE_SECRET=cambiar-secreto-mobile
BBF_CAJEROS_SECRET=cambiar-secreto-cajeros
